#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "plugin_screenshots"

options = { plugin: nil }
OptionParser
  .new do |opts|
    opts.banner = "Usage: bin/screenshot-plugins --plugin <id>"
    opts.on("--plugin ID", "Plugin id from config/plugins.yml (required for v0)") do |v|
      options[:plugin] = v
    end
  end
  .parse!

abort "missing --plugin" unless options[:plugin]

PluginScreenshots.run(plugin_id: options[:plugin])
